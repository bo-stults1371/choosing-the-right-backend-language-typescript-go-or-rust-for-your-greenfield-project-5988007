# Copy to .env and edit. .env is gitignored; never commit it.
# Values containing $, # or spaces: wrap them in single quotes ('...'), which is
# literal in both Docker Compose and scripts/pod-start.sh. Double quotes are not:
# Compose still expands $NAME inside them.

# --- SillyTavern HTTP Basic Auth (required) ---
# Startup fails if the password is empty or a known default (password, changeme, ...).
ST_BASIC_AUTH_USER=companion
ST_BASIC_AUTH_PASSWORD=

# --- ElevenLabs TTS (optional) ---
# If set, seeded into SillyTavern secrets as api_key_elevenlabs. Otherwise paste it in the UI.
ELEVENLABS_API_KEY=

# --- Persistent volume on the pod (models, SillyTavern config/data/plugins/extensions) ---
DATA_ROOT=/workspace/companion

# --- Model (Q4_K is 21.7 GB on disk) ---
HF_REPO=huihui-ai/Huihui-Qwen3.6-35B-A3B-abliterated-MTP-GGUF
MODEL_FILE=Huihui-Qwen3.6-35B-A3B-abliterated-ggml-model-Q4_K.gguf
# Only needed for gated/private repos.
HF_TOKEN=

# --- llama-server ---
LLAMA_CTX=262144
LLAMA_NGL=99
LLAMA_SPEC_DRAFT_N_MAX=6
# Appended verbatim to the llama-server command line (split on whitespace).
LLAMA_EXTRA_ARGS=
# Optional. If set, llama-server requires it as a Bearer token and it is seeded
# into SillyTavern secrets as api_key_llamacpp.
LLAMA_API_KEY=

# --- Build / publish knobs ---
# Branch, tag or commit SHA of ggml-org/llama.cpp to build (both paths).
LLAMA_CPP_REF=master
# Port SillyTavern is published on (both paths).
ST_PORT=8000
# Docker Compose only. CUDA_VERSION must not be newer than what the pod's NVIDIA
# driver supports (see nvidia-smi); ST_BIND is the host interface for ST_PORT.
CUDA_VERSION=12.4.1
ST_BIND=0.0.0.0

# No-Docker pod path only: stop the Runpod pod after this many minutes with no
# chat activity (0 = never). Uses runpodctl / RUNPOD_API_KEY inside the pod.
IDLE_STOP_MINUTES=0
